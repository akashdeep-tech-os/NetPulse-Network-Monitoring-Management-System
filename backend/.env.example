# JWT Secret Key (leave empty to auto-generate and persist one on first run)
SECRET_KEY=

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./ping_monitor.db

# CORS Origins (comma-separated) - default: localhost dev origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Initial administrator account (only used on first run / if no admin exists)
# If ADMIN_PASSWORD is empty, a random password is generated and saved to
# admin_credentials.txt next to the database.
ADMIN_USERNAME=Surakshitcity
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Login rate limiting (failed attempts per IP/username before temporary lockout)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Optional HTTPS termination (provide cert + key files)
# SSL_CERTFILE=./cert.pem
# SSL_KEYFILE=./key.pem

# Email Alert Settings (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_USE_TLS=true
ALERT_RECIPIENTS=admin@example.com,ops@example.com

# Slack Alert Settings
SLACK_WEBHOOK_URL=hooks.slack.com/services/your-workspace/your-channel/your-token
