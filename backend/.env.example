# JWT Secret Key (change in production!)
SECRET_KEY=your-secret-key-change-in-production

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./ping_monitor.db

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Email Alert Settings (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_USE_TLS=true
ALERT_RECIPIENTS=admin@example.com,ops@example.com

# Slack Alert Settings
SLACK_WEBHOOK_URL=hooks.slack.com/services/your-workspace/your-channel/your-token
